{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cadcraft-ai",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "DATABASE_PROVIDER": "d1",
    "VITE_APP_URL": "https://cadcraft.org",
    "VITE_APP_NAME": "CADCraft AI",
    "VITE_APP_DESCRIPTION": "CADCraft download and installation guide, Autodesk AutoCAD feature comparison and user experience",
    "VITE_APP_LOGO": "/logo.svg",
    "VITE_DEFAULT_LOCALE": "en"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cadcraft-ai",
      "database_id": "e3f6fa92-0a2e-46dd-9102-4f5a62dba48f",
      "migrations_dir": "drizzle"
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "routes": [
    {
      "pattern": "cadcraft.org",
      "custom_domain": true
    },
    {
      "pattern": "www.cadcraft.org",
      "custom_domain": true
    }
  ]
}
